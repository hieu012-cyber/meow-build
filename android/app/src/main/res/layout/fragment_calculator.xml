<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="end">

        <TextView
            android:id="@+id/tvHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:minHeight="20dp"
            android:maxLines="1"
            android:ellipsize="start" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/text"
            android:textSize="40sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="start"
            android:gravity="end" />
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:columnCount="4"
        android:rowCount="5">

        <Button android:id="@+id/btnC"     style="@style/Widget.UtilityHub.Button" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="C" android:textSize="20sp" android:backgroundTint="#334155" />
        <Button android:id="@+id/btnSign"  style="@style/Widget.UtilityHub.Button" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="±" android:textSize="20sp" android:backgroundTint="#334155" />
        <Button android:id="@+id/btnPct"   style="@style/Widget.UtilityHub.Button" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="%" android:textSize="20sp" android:backgroundTint="#334155" />
        <Button android:id="@+id/btnDiv"   style="@style/Widget.UtilityHub.Button" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="÷" android:textSize="20sp" android:backgroundTint="#7C3AED" />

        <Button android:id="@+id/btn7"     style="@style/Widget.UtilityHub.Button" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="7" android:textSize="20sp" android:backgroundTint="#1E293B" />
        <Button android:id="@+id/btn8"     style="@style/Widget.UtilityHub.Button" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="8" android:textSize="20sp" android:backgroundTint="#1E293B" />
        <Button android:id="@+id/btn9"     style="@style/Widget.UtilityHub.Button" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="9" android:textSize="20sp" android:backgroundTint="#1E293B" />
        <Button android:id="@+id/btnMul"   style="@style/Widget.UtilityHub.Button" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="×" android:textSize="20sp" android:backgroundTint="#7C3AED" />

        <Button android:id="@+id/btn4"     style="@style/Widget.UtilityHub.Button" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="4" android:textSize="20sp" android:backgroundTint="#1E293B" />
        <Button android:id="@+id/btn5"     style="@style/Widget.UtilityHub.Button" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="5" android:textSize="20sp" android:backgroundTint="#1E293B" />
        <Button android:id="@+id/btn6"     style="@style/Widget.UtilityHub.Button" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="6" android:textSize="20sp" android:backgroundTint="#1E293B" />
        <Button android:id="@+id/btnSub"   style="@style/Widget.UtilityHub.Button" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="−" android:textSize="20sp" android:backgroundTint="#7C3AED" />

        <Button android:id="@+id/btn1"     style="@style/Widget.UtilityHub.Button" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="1" android:textSize="20sp" android:backgroundTint="#1E293B" />
        <Button android:id="@+id/btn2"     style="@style/Widget.UtilityHub.Button" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="2" android:textSize="20sp" android:backgroundTint="#1E293B" />
        <Button android:id="@+id/btn3"     style="@style/Widget.UtilityHub.Button" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="3" android:textSize="20sp" android:backgroundTint="#1E293B" />
        <Button android:id="@+id/btnAdd"   style="@style/Widget.UtilityHub.Button" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="+" android:textSize="20sp" android:backgroundTint="#7C3AED" />

        <Button android:id="@+id/btn0"     style="@style/Widget.UtilityHub.Button" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_columnSpan="2" android:text="0" android:textSize="20sp" android:backgroundTint="#1E293B" />
        <Button android:id="@+id/btnDot"   style="@style/Widget.UtilityHub.Button" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="." android:textSize="20sp" android:backgroundTint="#1E293B" />
        <Button android:id="@+id/btnEq"    style="@style/Widget.UtilityHub.Button" android:layout_columnWeight="1" android:layout_rowWeight="1" android:text="=" android:textSize="20sp" android:backgroundTint="@color/primary" />

    </GridLayout>
</LinearLayout>
