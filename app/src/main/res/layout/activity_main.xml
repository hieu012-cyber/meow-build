<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cream" android:fillViewport="true">
 <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
  <LinearLayout android:background="@drawable/bg_header" android:padding="24dp" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
   <TextView android:text="LỊCH ÂM DƯƠNG" android:textColor="@color/gold" android:textSize="13sp" android:letterSpacing="0.25" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
   <LinearLayout android:orientation="horizontal" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
    <TextView android:id="@+id/tvSolarBig" android:text="06" android:textSize="72sp" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <LinearLayout android:orientation="vertical" android:layout_marginStart="14dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
     <TextView android:id="@+id/tvMonthYear" android:text="Thứ Sáu • Tháng 11/2026" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
     <TextView android:id="@+id/tvLunarBig" android:text="19/9 nhuận • Giáp Thìn" android:textColor="@color/gold_light" android:textSize="15sp" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
   </LinearLayout>
   <LinearLayout android:orientation="horizontal" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/chipTietKhi" android:background="@drawable/bg_chip" android:textColor="#fff" android:padding="8dp" android:text="Tiết khí" android:layout_marginEnd="8dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" />
    <TextView android:id="@+id/chipCanChi" android:background="@drawable/bg_chip" android:textColor="#fff" android:padding="8dp" android:text="Can chi" android:layout_marginEnd="8dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" />
    <TextView android:id="@+id/chipHoangDao" android:background="@drawable/bg_chip" android:textColor="#fff" android:padding="8dp" android:text="Hoàng đạo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" />
   </LinearLayout>
   <LinearLayout android:orientation="horizontal" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center">
    <Button android:id="@+id/btnPrev" android:text="‹" android:textSize="22sp" android:backgroundTint="#22FFFFFF" android:textColor="#fff" android:layout_width="48dp" android:layout_height="48dp" />
    <TextView android:id="@+id/tvCalTitle" android:text="Tháng 11 • 2026" android:textColor="#fff" android:textStyle="bold" android:textSize="17sp" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
    <Button android:id="@+id/btnNext" android:text="›" android:textSize="22sp" android:backgroundTint="#22FFFFFF" android:textColor="#fff" android:layout_width="48dp" android:layout_height="48dp" />
    <Button android:id="@+id/btnToday" android:text="Hôm nay" android:layout_marginStart="8dp" android:backgroundTint="@color/gold" android:textColor="#1A2A5E" android:layout_width="wrap_content" android:layout_height="48dp" />
   </LinearLayout>
  </LinearLayout>
  <GridLayout android:id="@+id/gridWeek" android:columnCount="7" android:layout_margin="16dp" android:layout_marginBottom="0dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
  <GridLayout android:id="@+id/gridCal" android:columnCount="7" android:layout_margin="12dp" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
  <LinearLayout android:background="@drawable/bg_card" android:elevation="6dp" android:orientation="vertical" android:padding="18dp" android:layout_margin="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
   <TextView android:text="CHI TIẾT NGÀY" android:textColor="@color/red_lunar" android:textStyle="bold" android:textSize="13sp" android:letterSpacing="0.2" android:layout_width="wrap_content" android:layout_height="wrap_content" />
   <TextView android:id="@+id/tvDetail" android:textSize="15sp" android:textColor="@color/deep_navy" android:lineSpacingExtra="4dp" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
   <TextView android:id="@+id/tvQuote" android:textSize="13sp" android:textColor="#7A86A8" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
  </LinearLayout>
 </LinearLayout>
</ScrollView>
